(version 1)
# BEGIN Backplane fab profile (regenerated by Backplane from the fab's published limits; edits between these lines are replaced)
# profile rev 2 of 2026-11-18, for a pcb board: 4 layers, 1 oz, 1.6 mm, enig; base-price limits
# clearance: every net class is at or above the fab's 0.09mm (https://jlcpcb.com/capabilities/pcb-capabilities, read 2026-11-18)
# track width: the project's 0.1mm is as strict as the fab's 0.09mm or stricter
# via diameter: the project's 0.45mm is as strict as the fab's 0.45mm or stricter
# via hole: the project's 0.2mm is as strict as the fab's 0.2mm or stricter
# pad hole: the project's 0.2mm is as strict as the fab's 0.2mm or stricter
# non-plated hole: the fab's 0.5mm (https://jlcpcb.com/capabilities/pcb-capabilities, read 2026-11-18)
(rule "fab: non-plated hole"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
	(constraint hole_size (min 0.5mm)))
# via ring: the project's 0.1mm is as strict as the fab's 0.05mm or stricter
# plated hole ring: the fab's 0.15mm (https://jlcpcb.com/capabilities/pcb-capabilities, read 2026-11-18)
(rule "fab: plated hole ring"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint annular_width (min 0.15mm)))
# hole to hole: the project's 0.5mm is as strict as the fab's 0.2mm or stricter
# pad hole to pad hole: the fab's 0.45mm (https://jlcpcb.com/capabilities/pcb-capabilities, read 2026-11-18)
(rule "fab: pad hole to pad hole"
	(condition "A.Type == 'Pad' && B.Type == 'Pad'")
	(constraint hole_to_hole (min 0.45mm)))
# hole to copper: the project's 0.25mm is as strict as the fab's 0.2mm or stricter
# plated hole to copper: the fab's 0.28mm (https://jlcpcb.com/capabilities/pcb-capabilities, read 2026-11-18)
(rule "fab: plated hole to copper"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint hole_clearance (min 0.28mm)))
# copper to edge: the project's 0.3mm is as strict as the fab's 0.2mm or stricter
# silkscreen text height: the project's 1mm is as strict as the fab's 1mm or stricter
# silkscreen text line: the project's 0.15mm is as strict as the fab's 0.15mm or stricter
# END Backplane fab profile

# Side-view LEDs D1/D5/D6: pads 0.2 mm from the bottom edge, lens sticks out about 0.3-0.4 mm past it
# (JLC routed-edge minimum is 0.2 mm; board default stays 0.3 mm).
(rule "side_led_edge"
	(condition "A.Type == 'Pad' && (A.memberOfFootprint('D1') || A.memberOfFootprint('D5') || A.memberOfFootprint('D6'))")
	(constraint edge_clearance (min 0.2mm)))

# +-20 V e-paper gate rails: at least 0.2 mm to any other net.
(rule "epd_hv_clearance"
	(condition "A.hasNetclass('EPD_BOOST')")
	(constraint clearance (min 0.2mm)))

# SHT40 island (moated, top edge) and its bridge: thin tracks only, so the sensor stays thermally isolated.
(rule "sht_island_thin"
	(condition "A.Type == 'Track' && A.intersectsArea('SHT_island_no_pour')")
	(constraint track_width (min 0.1mm) (opt 0.15mm) (max 0.15mm)))

# U6 (BQ24073) EP: centre via plus four in the cross between the paste windows,
# 0.55 mm pitch, 0.2 mm drills (0.35 mm hole gap; JLC via hole spacing min 0.2 mm).
(rule "u6_ep_thermal_vias"
	(condition "A.Type == 'Via' && B.Type == 'Via' && A.NetName == B.NetName && A.intersectsCourtyard('U6') && B.intersectsCourtyard('U6')")
	(constraint hole_to_hole (min 0.3mm)))

# U7 (RT9080) GND pin: solid to the pour for heat (WiFi bursts ~0.1-0.4 W in a TSOT-23).
(rule "u7_gnd_solid"
	(condition "A.Type == 'Pad' && A.memberOfFootprint('U7') && A.NetName == 'GND'")
	(constraint zone_connection solid))

# U5 (MAX17048) exposed pad: paste reduced to ~60% (1.0 x 0.6 of 1.2 x 0.8) so the TDFN doesn't float.
(rule "u5_ep_paste"
	(condition "A.Type == 'Pad' && A.memberOfFootprint('U5') && A.Pad_Number == '9'")
	(constraint solder_paste_abs_margin (opt -0.1mm)))

# JLC silkscreen: >= 0.15 mm from pads (silk on exposed copper is removed), keep silk items apart
(rule "silk_to_pad" (layer "?.Silkscreen") (condition "B.Type == 'Pad'") (constraint silk_clearance (min 0.15mm)))
(rule "silk_to_silk" (layer "?.Silkscreen") (constraint silk_clearance (min 0.1mm)))
