(version 1)

# Side-view LEDs D1/D5/D6: pads 0.2 mm from the bottom edge, lens sticks out about 0.3-0.4 mm past it
# (JLC routed-edge minimum is 0.2 mm; board default stays 0.3 mm).
(rule "side_led_edge"
	(condition "A.Type == 'Pad' && (A.memberOfFootprint('D1') || A.memberOfFootprint('D5') || A.memberOfFootprint('D6'))")
	(constraint edge_clearance (min 0.19mm)))

# +-20 V e-paper gate rails: at least 0.2 mm to any other net.
(rule "epd_hv_clearance"
	(condition "A.hasNetclass('EPD_BOOST')")
	(constraint clearance (min 0.2mm)))

# SHT40 island (moated, top edge) and its bridge: thin tracks only, so the sensor stays thermally isolated.
(rule "sht_island_thin"
	(condition "A.Type == 'Track' && A.intersectsArea('SHT_island_no_pour')")
	(constraint track_width (min 0.1mm) (opt 0.15mm) (max 0.15mm)))

# U6 (BQ24073) EP: centre via plus four in the cross between the paste windows,
# 0.55 mm pitch, 0.2 mm drills (0.35 mm hole gap; JLC via hole spacing min 0.2 mm).
(rule "u6_ep_thermal_vias"
	(condition "A.Type == 'Via' && B.Type == 'Via' && A.NetName == B.NetName && A.intersectsCourtyard('U6') && B.intersectsCourtyard('U6')")
	(constraint hole_to_hole (min 0.3mm)))

# U7 (RT9080) GND pin: solid to the pour for heat (WiFi bursts ~0.1-0.4 W in a TSOT-23).
(rule "u7_gnd_solid"
	(condition "A.Type == 'Pad' && A.memberOfFootprint('U7') && A.NetName == 'GND'")
	(constraint zone_connection solid))

# U5 (MAX17048) exposed pad: paste reduced to ~60% (1.0 x 0.6 of 1.2 x 0.8) so the TDFN doesn't float.
(rule "u5_ep_paste"
	(condition "A.Type == 'Pad' && A.memberOfFootprint('U5') && A.Pad_Number == '9'")
	(constraint solder_paste_abs_margin (opt -0.1mm)))

# JLC silkscreen: >= 0.15 mm from pads (silk on exposed copper is removed), keep silk items apart
(rule "silk_to_pad" (layer "?.Silkscreen") (condition "B.Type == 'Pad'") (constraint silk_clearance (min 0.15mm)))
(rule "silk_to_silk" (layer "?.Silkscreen") (constraint silk_clearance (min 0.1mm)))
