(version 1)

# Side-view LEDs D1/D5/D6: emitting face 0.1 mm inside the bottom edge, pads 0.2 mm from it
# (JLC routed-edge minimum is 0.2 mm; board default stays 0.3 mm).
(rule "side_led_edge"
	(condition "A.Type == 'Pad' && (A.Parent.Reference == 'D1' || A.Parent.Reference == 'D5' || A.Parent.Reference == 'D6')")
	(constraint edge_clearance (min 0.19mm)))

# +-20 V e-paper gate rails: at least 0.2 mm to any other net.
(rule "epd_hv_clearance"
	(condition "A.hasNetclass('EPD_BOOST')")
	(constraint clearance (min 0.2mm)))

# SHT31 tab and neck: thin tracks only, so the sensor stays thermally isolated.
(rule "sht_tab_thin"
	(condition "A.Type == 'Track' && A.intersectsArea('SHT_TAB_no_pour')")
	(constraint track_width (min 0.1mm) (opt 0.15mm) (max 0.15mm)))
