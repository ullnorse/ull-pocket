	)
	(text "BATTERY\nQ2 (AO3400A) in the BAT- lead blocks a\nreversed cell. MAX17048 and BQ24073 see\nsystem GND. Mark + and - on the J2 silk."
		(exclude_from_sim no)
		(at 244.38 212.61 0)
		(effects
