	)
	(text "FIRMWARE\nSet the MAX17048 VALRT / cutoff and the\nbrownout level to about 3.5 V: the RT9080\ndrops out below that."
		(exclude_from_sim no)
		(at 161.92 231.61 0)
		(effects
