	)
	(text "I2C addresses:\nSHT31 0x44 (ADDR=GND)\nBMP585 0x46 (SDO=GND)\nLIS3DH 0x19 (SA0=3V3)\nMAX17048 0x36"
		(exclude_from_sim no)
		(at 120.65 137.16 0)
		(effects
