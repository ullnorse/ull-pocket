		(uuid "07b27e6c-9b38-558a-b4aa-529ae5d60271")
	)
	(text "PULL-UPS / PULL-DOWNS\nEPD_CS_N, EPD_RST_N: 100k to +3V3 keep the\npanel idle while the MCU sleeps.\nR24: 10k to +3V3 on IO9 (BOOT strap),\nalso the pull-up of SW3 (DN). IO15 drives\nLED_G (strap only if JTAG_SEL burned)."
		(exclude_from_sim no)
		(at 244.38 231.61 0)
		(effects
			(font
				(size 1.65 1.65)
			)
			(justify left top)
		)
		(uuid "07e95c72-6105-5521-89e0-e229217ef818")
	)
