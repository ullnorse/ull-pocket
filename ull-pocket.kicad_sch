	)
	(text "ICHG = 890/2.2k = 405 mA\nUSB500: EN1=1, EN2=0\n-> IIN <= 500 mA\nTS: TH1 10k NTC (B3950), R8 10k DNP\nCharge window 3.5..47.2 C (see NOTES)\nTMR open: 4-6 h timer"
		(exclude_from_sim no)
		(at 191.77 68.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "22adaef0-8005-5da9-8393-8f7fa90e5e41")
	)
	(text "I2C addresses:\nSHT40 0x44\nBMP580 0x46 (SDO=GND)\nLIS2DW12 0x19 (SA0=3V3)\nMAX17048 0x36"
		(exclude_from_sim no)
		(at 151.13 144.78 0)
		(effects
