	)
	(text "LP GPIO (IO0-IO5 ext1 wake):\nIO0 BAT_ALRT_N\nIO1 USB_PGOOD_N\nIO2 BTN_N (UP)\nIO3 ACC_INT1\nIO4 BARO_INT\nIO5 BTN2_N (OK)\nIO6/7 LP_I2C\nIO8 LED_R (strap)\nIO14 LED_B\nIO15 LED_G\nIO9 BTN3_N (DN/BOOT)"
		(exclude_from_sim no)
		(at 15.24 93.36 0)
