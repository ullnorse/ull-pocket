	(text "WAKE POLARITY (ext1, one level)\nACC_INT1, BARO_INT: active-high by default.\nBTN_N, BTN2_N, BAT_ALRT_N, USB_PGOOD_N:\nactive-low. Set LIS2DW12 H_LACTIVE and\nBMP580 int_pol to active-low so one ext1\nlevel wakes all. BTN3_N (IO9) is polled."
		(exclude_from_sim no)
		(at 161.92 191.61 0)
		(effects
			(font
				(size 1.65 1.65)
			)
			(justify left top)
		)
		(uuid "8861ce66-7d37-5c2f-a797-40be38bba3c2")
	)
