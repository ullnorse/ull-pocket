	)
	(text "BATTERY TEMPERATURE (TS)\nTH1 10k NTC B3435 (0603): place against the\ncell. R8 10k (DNP) is the fallback.\n75 uA bias trips at 0.30 V and 2.1 V:\ncharging 0.5..50.8 C (resume < 47.9, > 3.9 C).\nBias flows only while VBUS is present."
		(exclude_from_sim no)
		(at 326.38 218.61 0)
		(effects
			(font
				(size 1.65 1.65)
			)
