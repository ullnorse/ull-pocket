	(text "WAKE POLARITY (ext1, one level)\nACC_INT1, BARO_INT: active-high by default.\nBTN_N, BAT_ALRT_N, USB_PGOOD_N: active-low.\nSet LIS3DH INT_POLARITY and BMP585 int_pol\nto active-low so one ext1 level wakes all."
		(exclude_from_sim no)
		(at 161.92 191.61 0)
		(effects
			(font
				(size 1.65 1.65)
