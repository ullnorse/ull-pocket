	)
	(text "LEDS: XL-1606 side-view, bottom edge (1.1-1.5 mA)\nD5 green: VBUS-2k, (5.0-2.6)/2k = 1.2 mA.\n   Lit with USB present, 0 on battery.\nD1 red CHG: VSYS(4.4)-2k, Vf 1.8: 1.3 mA.\nD6 blue IO5: 470R, Vf 2.6-2.8 @1 mA: 1.1-1.5 mA.\nSilkscreen: D5 PWR, D1 CHG, D6 USR.\nNo addressable LEDs: idle current."
		(exclude_from_sim no)
		(at 326.38 191.61 0)
		(effects
			(font
				(size 1.65 1.65)
			)
			(justify left top)
